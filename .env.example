# ============================================
# FRANQUICIAS API - VARIABLES DE ENTORNO
# ============================================
# PLANTILLA DE VARIABLES DE ENTORNO
# Copiar este archivo a .env y llenar con valores reales
# NUNCA commitear .env con valores reales de producción

# ============================================
# MYSQL DATABASE
# ============================================
MYSQL_ROOT_PASSWORD=tu_password_root_aqui
MYSQL_USER=tu_usuario_aqui
MYSQL_PASSWORD=tu_password_usuario_aqui
MYSQL_DATABASE=franquicias_db
MYSQL_PORT=3306

# ============================================
# APPLICATION SERVER
# ============================================
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# ============================================
# DATABASE CONNECTION (R2DBC)
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=franquicias_db
DB_USERNAME=tu_usuario_aqui
DB_PASSWORD=tu_password_usuario_aqui

# ============================================
# JWT SECURITY
# ============================================
# IMPORTANTE: Generar una clave segura para producción
# Mínimo 256 bits para HMAC-SHA256
JWT_SECRET=57990c74629e1fa30a55a37ee8fcd0ae39991e4fdf3271f227d6d2bfb5f75c29d
JWT_EXPIRATION=3600000

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
SPRING_LOG_LEVEL=INFO

# ============================================
# SWAGGER/OpenAPI
# ============================================
SWAGGER_ENABLED=true
API_TITLE=Franquicias API
API_VERSION=1.0.0
API_DESCRIPTION=API REST para gestión de franquicias

# ============================================
# CORS
# ============================================
# Para producción: especificar origins permitidos
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_MAX_AGE=3600

# ============================================
# APPLICATION ENVIRONMENT
# ============================================
ENVIRONMENT=development
TIMEZONE=America/Bogota
