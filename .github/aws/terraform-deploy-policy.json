{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TerraformStateReadWriteBasic",
      "Effect": "Allow",
      "Action": [
        "ec2:*",
        "rds:*",
        "iam:PassRole",
        "iam:GetRole",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:GetRolePolicy",
        "iam:CreateServiceLinkedRole",
        "kms:ListAliases",
        "kms:DescribeKey",
        "cloudwatch:PutMetricAlarm",
        "cloudwatch:DeleteAlarms",
        "logs:CreateLogGroup",
        "logs:PutRetentionPolicy",
        "logs:DeleteLogGroup",
        "tag:GetResources",
        "tag:TagResources",
        "tag:UntagResources",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    }
  ]
}
